<?xml version="1.0" encoding="utf-8"?>
<!-- "CleanFrame Clock": a CleanFrame or Unsplash photo, dimmed, with a clock that drifts a
     little each minute so no part of the panel holds the same image. -->
<component name="ScreensaverScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/Common.brs" />
  <script type="text/brightscript" uri="pkg:/components/ScreensaverScene.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Poster id="photo" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0" />
    <Rectangle id="dim" width="1920" height="1080" color="0x00000070" />
    <Group id="face">
      <Label id="time" width="1200" horizAlign="center" color="0xFFFFFFE6">
        <Font role="font" uri="pkg:/fonts/Geist-Light.ttf" size="220" />
      </Label>
      <Label id="date" width="1200" translation="[0,250]" horizAlign="center" color="0xFFFFFFB0">
        <Font role="font" uri="pkg:/fonts/Geist-Medium.ttf" size="40" />
      </Label>
    </Group>
    <Label id="credit" translation="[72,1012]" width="1200" color="0xFFFFFF90">
      <Font role="font" uri="pkg:/fonts/Geist-Medium.ttf" size="24" />
    </Label>
    <Animation id="fadeIn" duration="2" easeFunction="linear">
      <FloatFieldInterpolator key="[0,1]" keyValue="[0,1]" fieldToInterp="photo.opacity" />
    </Animation>
    <Timer id="tick" repeat="true" duration="1" />
  </children>
</component>
